# ============================================
# POLYMARKET TRADING BOT - ENVIRONMENT CONFIG
# ============================================

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Master wallet (YOUR wallet - receives all fees)
MASTER_WALLET_PRIVATE_KEY=your_master_wallet_private_key
MASTER_WALLET_ADDRESS=your_master_wallet_address

# Encryption key for user wallet private keys (32-char secret)
WALLET_ENCRYPTION_KEY=your_32_character_encryption_secret_here

# Polymarket CLOB API
POLYMARKET_API_KEY=your_polymarket_api_key
POLYMARKET_API_SECRET=your_polymarket_api_secret
POLYMARKET_API_PASSPHRASE=your_polymarket_passphrase
POLYMARKET_HOST=https://clob.polymarket.com

# Polygon RPC (for on-chain txns)
POLYGON_RPC_URL=https://polygon-rpc.com
# Or use Alchemy: https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# USDC Contract on Polygon
USDC_CONTRACT=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174

# Trading Config
MAX_CONCURRENT_TRADES=3
BASE_BET_PERCENT=0.15
AGGRESSIVE_MODE=true

# Fee Config (DO NOT CHANGE - business logic)
PLATFORM_FEE_PERCENT=5
REFERRAL_FEE_PERCENT=5

# Database path
DB_PATH=./data/bot.db

# Bot admin Telegram ID (your Telegram user ID)
ADMIN_TELEGRAM_ID=your_telegram_id_here

# Server port (for webhooks/health)
PORT=3000
